# ============================================
# 环境变量配置示例
# ============================================

# 后端端口
BACKEND_PORT=3001

# 前端端口
FRONTEND_PORT=80

# Nginx 端口（使用 --profile with-nginx 时生效）
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Node 环境
NODE_ENV=production

# API 密钥（可选，也可以在 config.toml 中配置）
# VOLCENGINE_API_KEY=your_api_key_here
# MINIMAX_API_KEY=your_api_key_here
